# =============================================================================
# AFRIP API — environment reference
# =============================================================================
#
#   !!  NEVER COMMIT A FILLED-IN .env  !!
#
# Copy to `.env` for local development only. `.env` is git-ignored; keep it that
# way. In production these values do NOT come from a file:
#
#   Cloud Run — non-secret values via `--set-env-vars`, secrets via Google
#               Secret Manager and `--set-secrets` (scripts/deploy-cloudrun.sh
#               does both). A secret in --set-env-vars is readable by anyone
#               with run.services.get and is echoed by `gcloud run services
#               describe` — that is a leak, not a shortcut.
#   Netlify   — Site configuration -> Environment variables, with the secret
#               ones marked "secret" so they are write-only in the UI.
#
# cp .env.example .env
# =============================================================================


# -----------------------------------------------------------------------------
# HTTP
# -----------------------------------------------------------------------------

# Port the server binds, on 0.0.0.0. Defaults to 8080 when unset. Validated as
# an integer in 0-65535; anything else is a fatal config error at startup.
# Do NOT set this on Cloud Run — the platform injects PORT and overriding it
# causes the "container failed to listen on the port defined by PORT" failure.
PORT=8080

# production | development. Set to production in every deployed environment.
NODE_ENV=development


# -----------------------------------------------------------------------------
# Persistence
# -----------------------------------------------------------------------------

# Which adapter set the composition root wires up.
#
#   memory   — in-memory repositories. Zero setup, zero durability: all state is
#              lost on restart and is NOT shared between instances. Fine for
#              local dev, tests and a deploy smoke test. Never for real data,
#              and actively wrong on Netlify (see netlify/functions/api.mts).
#   supabase — Supabase Postgres. Fully wired and the recommended, persistent
#              choice for any real deployment. /health reports
#              "persistence":"supabase" once selected, and /ready returns 503
#              with a specific error if the database cannot be reached (200
#              once it can).
PERSISTENCE=supabase

# Supabase project REST endpoint.
# Dashboard -> Project Settings -> Data API -> Project URL.
# Required when PERSISTENCE=supabase — startup fails fast if this or the
# service-role key is missing in that mode. Not a secret.
SUPABASE_URL=https://your-project-ref.supabase.co

# ---- SECRET ---------------------------------------------------------------
# Supabase service-role key (a JWT beginning `eyJ...`).
# Dashboard -> Project Settings -> API keys -> service_role.
#
# This key BYPASSES ROW LEVEL SECURITY entirely. It is a full-database
# credential. It must only ever exist server-side: in Secret Manager, in the
# Netlify secret env store, or in your own git-ignored .env. It must never be
# shipped to a browser, embedded in a frontend bundle, pasted into an issue, or
# committed. If it leaks, rotate it immediately in the Supabase dashboard.
#
# Do not confuse it with the anon/publishable key, which is safe client-side and
# is the one a future dashboard frontend should use.
SUPABASE_SERVICE_ROLE_KEY=


# -----------------------------------------------------------------------------
# Authentication
# -----------------------------------------------------------------------------

# ---- SECRET ---------------------------------------------------------------
# Shared bearer token for the non-public routes. When unset, auth is DISABLED,
# those endpoints are open, and the server logs a loud warning at startup.
# Acceptable locally, never in a deployed environment.
#
# Callers send:  Authorization: Bearer <API_TOKEN>
# `/health`, `/ready` and `/public/*` stay unauthenticated so platform probes
# and the transparency endpoints work.
#
# Generate:  openssl rand -hex 32
#
# This is a stopgap. It is one token for every caller, so it carries no identity
# and cannot be revoked per-user — it is the thing to replace with Supabase Auth
# (JWT verification + RLS-scoped per-user access) before any real rollout.
API_TOKEN=


# -----------------------------------------------------------------------------
# Netlify-only knobs (ignored on Cloud Run) — see netlify/functions/api.mts
# -----------------------------------------------------------------------------

# Loopback port the wrapped server is booted on inside the Lambda container.
# Only change it if 8787 collides with something.
# AFRIP_INTERNAL_PORT=8787

# How long the function waits for the wrapped server to report healthy on a cold
# start, in ms. Must stay well below Netlify's 10s synchronous budget.
# AFRIP_BOOT_TIMEOUT_MS=8000
